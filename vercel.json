{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/smart-explorer",
      "destination": "https://github.com/nunco-git/ezgong/releases/download/smartexplorer-v1.0.0/SmartExplorer.exe",
      "permanent": false
    },
    {
      "source": "/download/smart-explorer/info",
      "destination": "https://github.com/nunco-git/ezgong/releases/tag/smartexplorer-v1.0.0",
      "permanent": false
    }
  ]
}
